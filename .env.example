# Local development only. Replace every value before deployment.
POSTGRES_DB=studio_app
POSTGRES_USER=studio_app
POSTGRES_PASSWORD=local-dev-change-me
DATABASE_URL=postgresql://studio_app:local-dev-change-me@localhost:5432/studio_app
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_APP_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=StudioSuite <no-reply@example.test>
# Local password reset messages print to the backend console by default.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
