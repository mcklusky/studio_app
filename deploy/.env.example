# Copy to deploy/.env and fill in. Never commit deploy/.env.

# The public domain staff will use, e.g. app.justsmileempire.com (DNS must point at this server).
SITE_DOMAIN=app.example.com

# Long random values. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Optional: move the Django admin away from /admin/ (letters only, no slashes).
DJANGO_ADMIN_PATH=admin

# Raise to 31536000 (one year) after HTTPS has worked for a few days.
HSTS_SECONDS=3600

# Error emails and password-reset emails (leave EMAIL_HOST empty to disable sending).
DJANGO_ADMINS=Owner owner@example.com
DEFAULT_FROM_EMAIL=Just Smile Empire <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Backups: folder on the server (copy it off-site regularly), hour of day to run, days to keep.
BACKUP_DIR=./backups
BACKUP_HOUR=1
BACKUP_RETENTION_DAYS=30
TZ=Africa/Monrovia

# ---- Local trial on one computer (not for real use) ----
# SITE_DOMAIN=localhost
# SITE_ADDRESS=localhost:8443
# HTTP_PORT=8080
# HTTPS_PORT=8443
# CSRF_TRUSTED_ORIGINS=https://localhost:8443
# PUBLIC_APP_URL=https://localhost:8443
# DJANGO_ALLOW_LOCALHOST_ONLY=true

# Public website: which organization it shows (blank = the only one with its website switched on).
PUBLIC_SITE_ORGANIZATION_ID=
